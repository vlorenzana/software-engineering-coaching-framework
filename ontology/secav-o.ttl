@prefix secav: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o>
    a owl:Ontology ;
    dcterms:title "Software Engineering Coaching and AI Validation Ontology (SECAV-O)"@en ;
    dcterms:creator "Victor Hugo Lorenzana González" ;
    dcterms:description "Initial experimental ontology connecting software-engineering activities, artifacts, competencies, evidence, measurement, AI assistance, human validation, assessment, and coaching."@en ;
    owl:versionInfo "0.1.0" ;
    rdfs:seeAlso <https://dev.nemo.inf.ufes.br/seon/SEON.html> .

secav:SoftwareEngineeringProcess a owl:Class ; rdfs:label "Software Engineering Process"@en .
secav:EngineeringActivity a owl:Class ; rdfs:label "Engineering Activity"@en .
secav:RequirementsActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Requirements Activity"@en .
secav:DesignActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Design Activity"@en .
secav:CodingActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Coding Activity"@en .
secav:TestingActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Testing Activity"@en .
secav:ImplementationActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Implementation Activity"@en .
secav:ReviewActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "Review Activity"@en .
secav:ApplicationDesign a owl:Class ; rdfs:subClassOf secav:DesignActivity ; rdfs:label "Application Design"@en .
secav:UnitTestDesign a owl:Class ; rdfs:subClassOf secav:DesignActivity ; rdfs:label "Unit Test Design"@en .
secav:DesignImplementation a owl:Class ; rdfs:subClassOf secav:ImplementationActivity, secav:DesignActivity ; rdfs:label "Design Implementation"@en .
secav:DesignReview a owl:Class ; rdfs:subClassOf secav:ReviewActivity, secav:DesignActivity ; rdfs:label "Design Review"@en .
secav:UnitTestDesignImplementation a owl:Class ; rdfs:subClassOf secav:ImplementationActivity, secav:UnitTestDesign ; rdfs:label "Unit Test Design Implementation"@en .
secav:UnitTestDesignReview a owl:Class ; rdfs:subClassOf secav:ReviewActivity, secav:UnitTestDesign ; rdfs:label "Unit Test Design Review"@en .
secav:CodeImplementation a owl:Class ; rdfs:subClassOf secav:ImplementationActivity, secav:CodingActivity ; rdfs:label "Code Implementation"@en .
secav:CodeReview a owl:Class ; rdfs:subClassOf secav:ReviewActivity, secav:CodingActivity ; rdfs:label "Code Review"@en .

secav:Artifact a owl:Class ; rdfs:label "Engineering Artifact"@en .
secav:DesignArtifact a owl:Class ; rdfs:subClassOf secav:Artifact ; rdfs:label "Design Artifact"@en .
secav:UnitTestDesignArtifact a owl:Class ; rdfs:subClassOf secav:Artifact ; rdfs:label "Unit Test Design Artifact"@en .
secav:SourceCodeArtifact a owl:Class ; rdfs:subClassOf secav:Artifact ; rdfs:label "Source Code Artifact"@en .

secav:Stakeholder a owl:Class ; rdfs:label "Stakeholder"@en .
secav:Engineer a owl:Class ; rdfs:subClassOf secav:Stakeholder ; rdfs:label "Engineer"@en .
secav:Coach a owl:Class ; rdfs:subClassOf secav:Stakeholder ; rdfs:label "Developer Coach"@en .
secav:AISystem a owl:Class ; rdfs:label "AI System"@en .

secav:Competency a owl:Class ; rdfs:label "Engineering Competency"@en .
secav:DesignCompetency a owl:Class ; rdfs:subClassOf secav:Competency ; rdfs:label "Design Competency"@en .
secav:ReviewCompetency a owl:Class ; rdfs:subClassOf secav:Competency ; rdfs:label "Review Competency"@en .
secav:TestingCompetency a owl:Class ; rdfs:subClassOf secav:Competency ; rdfs:label "Testing Competency"@en .
secav:SecurityCompetency a owl:Class ; rdfs:subClassOf secav:Competency ; rdfs:label "Security Competency"@en .
secav:PlanningCompetency a owl:Class ; rdfs:subClassOf secav:Competency ; rdfs:label "Planning Competency"@en .

secav:Evidence a owl:Class ; rdfs:label "Observable Evidence"@en .
secav:WorkProductEvidence a owl:Class ; rdfs:subClassOf secav:Evidence ; rdfs:label "Work Product Evidence"@en .
secav:ReviewFinding a owl:Class ; rdfs:subClassOf secav:Evidence ; rdfs:label "Review Finding"@en .
secav:DefectRecord a owl:Class ; rdfs:subClassOf secav:Evidence ; rdfs:label "Defect Record"@en .
secav:Measurement a owl:Class ; rdfs:subClassOf secav:Evidence ; rdfs:label "Measurement"@en .
secav:QualityCriterion a owl:Class ; rdfs:label "Quality Criterion"@en .
secav:AcceptanceCriterion a owl:Class ; rdfs:subClassOf secav:QualityCriterion ; rdfs:label "Acceptance Criterion"@en .

secav:ReviewRecord a owl:Class ; rdfs:subClassOf secav:Artifact, secav:Evidence ; rdfs:label "Review Record"@en .
secav:TestResult a owl:Class ; rdfs:subClassOf secav:Artifact, secav:Evidence ; rdfs:label "Test Result"@en .

secav:AIAssistedActivity a owl:Class ; rdfs:subClassOf secav:EngineeringActivity ; rdfs:label "AI-Assisted Activity"@en .
secav:HumanValidationActivity a owl:Class ; rdfs:subClassOf secav:ReviewActivity ; rdfs:label "Human Validation Activity"@en .

secav:CompetencyAssessment a owl:Class ; rdfs:label "Competency Assessment"@en .
secav:CoachingRecommendation a owl:Class ; rdfs:label "Coaching Recommendation"@en .
secav:CoachingIntervention a owl:Class ; rdfs:label "Coaching Intervention"@en .

secav:performs a owl:ObjectProperty ;
    rdfs:domain secav:Engineer ; rdfs:range secav:EngineeringActivity ; rdfs:label "performs"@en .

secav:produces a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:Artifact ; rdfs:label "produces"@en .

secav:evaluates a owl:ObjectProperty ;
    rdfs:domain secav:ReviewActivity ; rdfs:range secav:Artifact ; rdfs:label "evaluates"@en .

secav:requiresCompetency a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:Competency ; rdfs:label "requires competency"@en .

secav:providesEvidenceOf a owl:ObjectProperty ;
    rdfs:domain secav:Evidence ; rdfs:range secav:Competency ; rdfs:label "provides evidence of"@en .

secav:assistedByAI a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:AISystem ; rdfs:label "assisted by AI"@en .

secav:requiresHumanValidation a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:HumanValidationActivity ; rdfs:label "requires human validation"@en .

secav:measuredBy a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:Measurement ; rdfs:label "measured by"@en .

secav:assessedAgainst a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ; rdfs:range secav:QualityCriterion ; rdfs:label "assessed against"@en .

secav:reviews a owl:ObjectProperty ;
    rdfs:domain secav:Engineer ; rdfs:range secav:Artifact ; rdfs:label "reviews"@en .

secav:basedOnEvidence a owl:ObjectProperty ;
    rdfs:domain secav:CompetencyAssessment ; rdfs:range secav:Evidence ; rdfs:label "based on evidence"@en .

secav:assessesCompetency a owl:ObjectProperty ;
    rdfs:domain secav:CompetencyAssessment ; rdfs:range secav:Competency ; rdfs:label "assesses competency"@en .

secav:triggers a owl:ObjectProperty ;
    rdfs:domain secav:Evidence ; rdfs:range secav:CoachingIntervention ; rdfs:label "triggers"@en .

secav:targetsCompetency a owl:ObjectProperty ;
    rdfs:domain secav:CoachingIntervention ; rdfs:range secav:Competency ; rdfs:label "targets competency"@en .

secav:recommendedBy a owl:ObjectProperty ;
    rdfs:domain secav:CoachingIntervention ; rdfs:range secav:CoachingRecommendation ; rdfs:label "recommended by"@en .

secav:evidenceNote a owl:DatatypeProperty ;
    rdfs:domain secav:Evidence ; rdfs:range xsd:string ; rdfs:label "evidence note"@en .

secav:measurementValue a owl:DatatypeProperty ;
    rdfs:domain secav:Measurement ; rdfs:label "measurement value"@en .

secav:criterionStatement a owl:DatatypeProperty ;
    rdfs:domain secav:QualityCriterion ; rdfs:range xsd:string ; rdfs:label "criterion statement"@en .

secav:assessmentRationale a owl:DatatypeProperty ;
    rdfs:domain secav:CompetencyAssessment ; rdfs:range xsd:string ; rdfs:label "assessment rationale"@en .

# ---------------------------------------------------------------------------
# Review Antipatterns
# Derived from: coaching-governance/guides/peer-review-antipatterns.md
# A ReviewAntipattern is observable Evidence of a process degradation in a
# ReviewActivity. As Evidence it can trigger a CoachingIntervention.
# ---------------------------------------------------------------------------

secav:ReviewAntipattern a owl:Class ;
    rdfs:subClassOf secav:Evidence ;
    rdfs:label "Review Antipattern"@en ;
    rdfs:comment "An observable degradation pattern in a review activity that reduces review quality and may trigger a coaching intervention."@en .

# Category subclasses — group antipatterns by the dimension they affect

secav:CulturalReviewAntipattern a owl:Class ;
    rdfs:subClassOf secav:ReviewAntipattern ;
    rdfs:label "Cultural Review Antipattern"@en ;
    rdfs:comment "An antipattern rooted in team attitude or interpersonal dynamics during the review."@en .

secav:ProcessReviewAntipattern a owl:Class ;
    rdfs:subClassOf secav:ReviewAntipattern ;
    rdfs:label "Process Review Antipattern"@en ;
    rdfs:comment "An antipattern in the workflow or mechanics of submitting and routing review requests."@en .

secav:TechnicalReviewAntipattern a owl:Class ;
    rdfs:subClassOf secav:ReviewAntipattern ;
    rdfs:label "Technical Review Antipattern"@en ;
    rdfs:comment "An antipattern in the technical scope or depth of the review itself."@en .

secav:ClosureReviewAntipattern a owl:Class ;
    rdfs:subClassOf secav:ReviewAntipattern ;
    rdfs:label "Closure Review Antipattern"@en ;
    rdfs:comment "An antipattern in the follow-up, resolution, or closure of review comments."@en .

# Cultural antipatterns

secav:PunitiveReviewApproach a owl:Class ;
    rdfs:subClassOf secav:CulturalReviewAntipattern ;
    rdfs:label "Punitive Review Approach"@en ;
    rdfs:comment "The reviewer treats the review as a punitive audit — searching for culprits or errors to demonstrate technical superiority rather than collaborating to improve the artifact."@en .

secav:NonEmpathicReviewFeedback a owl:Class ;
    rdfs:subClassOf secav:CulturalReviewAntipattern ;
    rdfs:label "Non-Empathic Review Feedback"@en ;
    rdfs:comment "Review comments use an aggressive, sarcastic, or dismissive tone, targeting the author rather than the code and eroding psychological safety."@en .

secav:ReviewerDictatorship a owl:Class ;
    rdfs:subClassOf secav:CulturalReviewAntipattern ;
    rdfs:label "Reviewer Dictatorship"@en ;
    rdfs:comment "The reviewer forces changes solely because they would have written the code differently, even when the author's solution is functional, clean, and standards-compliant."@en .

# Process antipatterns

secav:OversizedPullRequest a owl:Class ;
    rdfs:subClassOf secav:ProcessReviewAntipattern ;
    rdfs:label "Oversized Pull Request"@en ;
    rdfs:comment "A pull request modifies hundreds or thousands of lines across many files, making thorough review impossible and leading to superficial approvals."@en .

secav:OversizedReviewSession a owl:Class ;
    rdfs:subClassOf secav:ProcessReviewAntipattern ;
    rdfs:label "Oversized Review Session"@en ;
    rdfs:comment "A review session exceeds 60 continuous minutes or 400 LOC, causing analytical fatigue and reduced defect detection."@en .

secav:RubberStampApproval a owl:Class ;
    rdfs:subClassOf secav:ProcessReviewAntipattern ;
    rdfs:label "Rubber-Stamp Approval"@en ;
    rdfs:comment "A pull request is approved without being read, due to time pressure, author seniority, or pipeline urgency, completely bypassing the quality filter."@en .

secav:SingleApproverBottleneck a owl:Class ;
    rdfs:subClassOf secav:ProcessReviewAntipattern ;
    rdfs:label "Single Approver Bottleneck"@en ;
    rdfs:comment "The team depends exclusively on one person to review all code, paralysing delivery whenever that person is unavailable or overloaded."@en .

secav:PrematureReviewRequest a owl:Class ;
    rdfs:subClassOf secav:ProcessReviewAntipattern ;
    rdfs:label "Premature Review Request"@en ;
    rdfs:comment "A formal review is requested before automated tests pass or while the artifact is still in draft state, invalidating prior review effort."@en .

# Technical antipatterns

secav:ManualStyleReview a owl:Class ;
    rdfs:subClassOf secav:TechnicalReviewAntipattern ;
    rdfs:label "Manual Style Review"@en ;
    rdfs:comment "Style and formatting issues are debated manually instead of being delegated to automated linters in CI/CD."@en .

secav:LateArchitecturalDiscussion a owl:Class ;
    rdfs:subClassOf secav:TechnicalReviewAntipattern ;
    rdfs:label "Late Architectural Discussion"@en ;
    rdfs:comment "The system design or architecture is questioned at review time — after the code is production-ready — rather than being agreed during the planning or design phase."@en .

secav:HappyPathOnlyReview a owl:Class ;
    rdfs:subClassOf secav:TechnicalReviewAntipattern ;
    rdfs:label "Happy Path Only Review"@en ;
    rdfs:comment "The reviewer verifies only the favourable scenario, ignoring missing unit/integration tests, error handling, and potential security vulnerabilities."@en .

secav:InsufficientAICodeScrutiny a owl:Class ;
    rdfs:subClassOf secav:TechnicalReviewAntipattern ;
    rdfs:label "Insufficient AI Code Scrutiny"@en ;
    rdfs:comment "AI-assisted code is approved without exhaustive human validation of business logic, introducing unaudited hallucinations or duplications."@en .

# Closure antipatterns

secav:MissingReviewContext a owl:Class ;
    rdfs:subClassOf secav:ClosureReviewAntipattern ;
    rdfs:label "Missing Review Context"@en ;
    rdfs:comment "The review request lacks a clear description of what changed, why, and the acceptance criteria — omitting test instructions or supporting screenshots — forcing the reviewer to infer intent."@en .

secav:InfiniteCommentLoop a owl:Class ;
    rdfs:subClassOf secav:ClosureReviewAntipattern ;
    rdfs:label "Infinite Comment Loop"@en ;
    rdfs:comment "A review comment thread extends beyond 2–3 exchanges without resolution. The protocol is to switch to a 5-minute synchronous call and document the agreed outcome."@en .

# ---------------------------------------------------------------------------
# Reviewer Readiness
# The bio-cognitive precondition state of the reviewer before a ReviewActivity.
# Modeled as a QualityCriterion: a condition that must be met for the
# ReviewActivity to produce reliable ReviewFinding evidence.
# ---------------------------------------------------------------------------

secav:ReviewerReadiness a owl:Class ;
    rdfs:subClassOf secav:QualityCriterion ;
    rdfs:label "Reviewer Readiness"@en ;
    rdfs:comment "The bio-cognitive precondition state of the reviewer. When unmet, defect-detection rate and feedback quality degrade."@en .

secav:ReviewerEnergyCondition a owl:Class ;
    rdfs:subClassOf secav:ReviewerReadiness ;
    rdfs:label "Reviewer Energy Condition"@en ;
    rdfs:comment "Complex reviews are scheduled during peak mental clarity windows (typically morning); never under extreme end-of-day fatigue."@en .

secav:ReviewerFocusCondition a owl:Class ;
    rdfs:subClassOf secav:ReviewerReadiness ;
    rdfs:label "Reviewer Focus Condition"@en ;
    rdfs:comment "A 30–60 minute focus block is reserved with notifications silenced, preventing context-switching losses."@en .

secav:ReviewerCriticalAnalysisCondition a owl:Class ;
    rdfs:subClassOf secav:ReviewerReadiness ;
    rdfs:label "Reviewer Critical Analysis Condition"@en ;
    rdfs:comment "Reviewer ignores style details already covered by automation and focuses cognitive energy on architecture, input security, and business logic."@en .

secav:ReviewerAssertiveClosureCondition a owl:Class ;
    rdfs:subClassOf secav:ReviewerReadiness ;
    rdfs:label "Reviewer Assertive Closure Condition"@en ;
    rdfs:comment "Reviewer qualifies contributions explicitly: approves when code fulfills its purpose with minor issues, leaving suggestions as optional improvements."@en .

# ---------------------------------------------------------------------------
# Review Request
# The artifact submitted to trigger a ReviewActivity (e.g., a Pull Request).
# A FormalReviewRequest requires a description and passing automated tests.
# A DraftReviewRequest is not yet eligible for formal review.
# ---------------------------------------------------------------------------

secav:ReviewRequest a owl:Class ;
    rdfs:subClassOf secav:Artifact ;
    rdfs:label "Review Request"@en ;
    rdfs:comment "An artifact (e.g., Pull Request) submitted to initiate a ReviewActivity."@en .

secav:FormalReviewRequest a owl:Class ;
    rdfs:subClassOf secav:ReviewRequest ;
    rdfs:label "Formal Review Request"@en ;
    rdfs:comment "A review request where automated tests pass, the artifact is complete, and a description of what, why, and acceptance criteria is present."@en .

secav:DraftReviewRequest a owl:Class ;
    rdfs:subClassOf secav:ReviewRequest ;
    rdfs:label "Draft Review Request"@en ;
    rdfs:comment "A work-in-progress review request not yet eligible for formal review."@en .

# ---------------------------------------------------------------------------
# New Object Properties
# ---------------------------------------------------------------------------

secav:hasAntipattern a owl:ObjectProperty ;
    rdfs:domain secav:ReviewActivity ;
    rdfs:range secav:ReviewAntipattern ;
    rdfs:label "has antipattern"@en ;
    rdfs:comment "Links a review activity to an observed degradation pattern."@en .

secav:hasReviewerReadiness a owl:ObjectProperty ;
    rdfs:domain secav:ReviewActivity ;
    rdfs:range secav:ReviewerReadiness ;
    rdfs:label "has reviewer readiness"@en ;
    rdfs:comment "Links a review activity to the bio-cognitive precondition state observed for the reviewer."@en .

# ---------------------------------------------------------------------------
# New Datatype Property
# ---------------------------------------------------------------------------

secav:requestDescription a owl:DatatypeProperty ;
    rdfs:domain secav:ReviewRequest ;
    rdfs:range xsd:string ;
    rdfs:label "request description"@en ;
    rdfs:comment "Structured description of the review request: what changed, why, and acceptance criteria."@en .

# ---------------------------------------------------------------------------
# Preventive Actions (Shift-Left)
# Derived from: coaching-governance/guides/shift-left-prevention.md
# A PreventiveAction is an EngineeringActivity performed proactively — earlier
# in the lifecycle — to prevent defects before they reach peer review.
# ---------------------------------------------------------------------------

secav:PreventiveAction a owl:Class ;
    rdfs:subClassOf secav:EngineeringActivity ;
    rdfs:label "Preventive Action"@en ;
    rdfs:comment "An engineering activity performed proactively to prevent defects from reaching the review phase."@en .

secav:AcceptanceCriteriaDefinition a owl:Class ;
    rdfs:subClassOf secav:PreventiveAction, secav:RequirementsActivity ;
    rdfs:label "Acceptance Criteria Definition"@en ;
    rdfs:comment "Defining verifiable acceptance criteria (BDD/TDD) before writing production code, eliminating logical ambiguity at the source."@en .

secav:APIContractDefinition a owl:Class ;
    rdfs:subClassOf secav:PreventiveAction, secav:DesignActivity ;
    rdfs:label "API Contract Definition"@en ;
    rdfs:comment "Defining API contracts and interfaces before parallel module implementation, preventing integration defects."@en .

secav:SelfReview a owl:Class ;
    rdfs:subClassOf secav:PreventiveAction, secav:ReviewActivity ;
    rdfs:label "Self Review"@en ;
    rdfs:comment "The engineer reviews their own artifact after a brief pause before submitting a formal review request, catching obvious defects with a fresh read."@en .

# ---------------------------------------------------------------------------
# API Contract Artifact
# The design artifact produced by APIContractDefinition.
# ---------------------------------------------------------------------------

secav:APIContractArtifact a owl:Class ;
    rdfs:subClassOf secav:DesignArtifact ;
    rdfs:label "API Contract Artifact"@en ;
    rdfs:comment "A design artifact specifying the contract, interface, or protocol between modules or services, agreed before parallel implementation begins."@en .

# ---------------------------------------------------------------------------
# Automation Gates
# Quality criteria enforced by automated tooling rather than human judgement.
# Subclass of QualityCriterion: these are conditions that must be satisfied
# for an EngineeringActivity to be considered complete.
# ---------------------------------------------------------------------------

secav:AutomationGate a owl:Class ;
    rdfs:subClassOf secav:QualityCriterion ;
    rdfs:label "Automation Gate"@en ;
    rdfs:comment "A quality criterion enforced by automated tooling (linters, hooks, CI/CD checks) rather than human review."@en .

secav:PreCommitHook a owl:Class ;
    rdfs:subClassOf secav:AutomationGate ;
    rdfs:label "Pre-Commit Hook"@en ;
    rdfs:comment "Blocks local commits if unit tests fail or if exposed environment variables are detected."@en .

secav:StrictTypingPolicy a owl:Class ;
    rdfs:subClassOf secav:AutomationGate ;
    rdfs:label "Strict Typing Policy"@en ;
    rdfs:comment "Compiler-enforced type strictness (e.g., noImplicitAny in TypeScript) that prevents implicit type errors at runtime."@en .

secav:CodeCoverageGate a owl:Class ;
    rdfs:subClassOf secav:AutomationGate ;
    rdfs:label "Code Coverage Gate"@en ;
    rdfs:comment "A minimum code coverage threshold (e.g., >80%) enforced locally before a push is permitted."@en .

# ---------------------------------------------------------------------------
# Developer Cognitive State
# The bio-cognitive precondition state of the engineer during implementation.
# Parallel to ReviewerReadiness but applies to coding activities.
# Modeled as QualityCriterion: a condition that must be met for a
# CodeImplementation to produce low-defect-density artifacts.
# ---------------------------------------------------------------------------

secav:DeveloperCognitiveState a owl:Class ;
    rdfs:subClassOf secav:QualityCriterion ;
    rdfs:label "Developer Cognitive State"@en ;
    rdfs:comment "The bio-cognitive precondition state of the engineer during implementation. When unmet, defect density in the artifact increases."@en .

secav:DeepWorkCondition a owl:Class ;
    rdfs:subClassOf secav:DeveloperCognitiveState ;
    rdfs:label "Deep Work Condition"@en ;
    rdfs:comment "45–60 minute focused coding blocks without external notifications, preserving the engineer's mental model of the logic."@en .

secav:FatigueManagementCondition a owl:Class ;
    rdfs:subClassOf secav:DeveloperCognitiveState ;
    rdfs:label "Fatigue Management Condition"@en ;
    rdfs:comment "Mandatory breaks after extended development blocks; accumulated fatigue degrades the ability to identify logical edge cases."@en .

secav:SelfReviewCondition a owl:Class ;
    rdfs:subClassOf secav:DeveloperCognitiveState ;
    rdfs:label "Self-Review Condition"@en ;
    rdfs:comment "A brief pause before self-reviewing local changes, allowing the engineer to detect obvious defects with a fresh perspective."@en .

# ---------------------------------------------------------------------------
# New Object Properties
# ---------------------------------------------------------------------------

secav:hasAutomationGate a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ;
    rdfs:range secav:AutomationGate ;
    rdfs:label "has automation gate"@en ;
    rdfs:comment "Links an engineering activity to the automated quality gates that must pass before the activity is considered complete."@en .

secav:hasDeveloperCognitiveState a owl:ObjectProperty ;
    rdfs:domain secav:CodeImplementation ;
    rdfs:range secav:DeveloperCognitiveState ;
    rdfs:label "has developer cognitive state"@en ;
    rdfs:comment "Links a code implementation activity to the bio-cognitive precondition state of the engineer performing it."@en .

secav:prevents a owl:ObjectProperty ;
    rdfs:domain secav:PreventiveAction ;
    rdfs:range secav:DefectRecord ;
    rdfs:label "prevents"@en ;
    rdfs:comment "Expresses that a preventive action is intended to avoid a class of defects from being introduced into the artifact."@en .

# ---------------------------------------------------------------------------
# New Datatype Property
# ---------------------------------------------------------------------------

secav:coverageThreshold a owl:DatatypeProperty ;
    rdfs:domain secav:CodeCoverageGate ;
    rdfs:range xsd:decimal ;
    rdfs:label "coverage threshold"@en ;
    rdfs:comment "The minimum code coverage percentage (0.0–1.0) required before a push is permitted."@en .

# ---------------------------------------------------------------------------
# AI-Assisted Code Review Extension
# Derived from: coaching-governance/guides/ai-assisted-code-review.md §6
# These classes and properties model the layered pipeline, review dimensions,
# prompt configuration, risk triage, and pipeline ordering used in
# AI-assisted code review workflows.
# ---------------------------------------------------------------------------

# § Review Dimensions — named focus areas that partition responsibility
# between AI and human reviewers within a single HumanValidationActivity.

secav:ReviewDimension a owl:Class ;
    rdfs:label "Review Dimension"@en ;
    rdfs:comment "A named classification of review focus area (e.g., SyntaxStyle, BusinessLogic, Security) that determines which agent — AI or human — holds primary responsibility."@en .

secav:aiPrimaryForDimension a owl:ObjectProperty ;
    rdfs:domain secav:AISystem ;
    rdfs:range secav:ReviewDimension ;
    rdfs:label "AI primary for dimension"@en ;
    rdfs:comment "The AI system holds primary review responsibility for this dimension."@en .

secav:humanPrimaryForDimension a owl:ObjectProperty ;
    rdfs:domain secav:HumanValidationActivity ;
    rdfs:range secav:ReviewDimension ;
    rdfs:label "human primary for dimension"@en ;
    rdfs:comment "The human reviewer holds primary review responsibility for this dimension."@en .

# § Prompt Configuration — quality requirement for structuring AI review passes.

secav:QualityActivityRequirement a owl:Class ;
    rdfs:subClassOf secav:QualityCriterion ;
    rdfs:label "Quality Activity Requirement"@en ;
    rdfs:comment "A structured precondition that must be satisfied for an engineering activity to produce reliable output."@en .

secav:AIReviewPromptConfiguration a owl:Class ;
    rdfs:subClassOf secav:QualityActivityRequirement ;
    rdfs:label "AI Review Prompt Configuration"@en ;
    rdfs:comment "The 4-step prompt configuration sequence (context → impact → security → test generation) required before an AI review pass."@en .

secav:hasContextDefinition a owl:DatatypeProperty ;
    rdfs:domain secav:AIReviewPromptConfiguration ;
    rdfs:range xsd:string ;
    rdfs:label "has context definition"@en ;
    rdfs:comment "Step 1: the prompt instruction that provides codebase and business context to the AI reviewer."@en .

secav:hasImpactAnalysisInstruction a owl:DatatypeProperty ;
    rdfs:domain secav:AIReviewPromptConfiguration ;
    rdfs:range xsd:string ;
    rdfs:label "has impact analysis instruction"@en ;
    rdfs:comment "Step 2: the prompt instruction directing the AI to analyze the impact of the change on existing functionality."@en .

secav:hasSecurityEvaluationInstruction a owl:DatatypeProperty ;
    rdfs:domain secav:AIReviewPromptConfiguration ;
    rdfs:range xsd:string ;
    rdfs:label "has security evaluation instruction"@en ;
    rdfs:comment "Step 3: the prompt instruction directing the AI to evaluate the change for security vulnerabilities."@en .

secav:hasTestGenerationInstruction a owl:DatatypeProperty ;
    rdfs:domain secav:AIReviewPromptConfiguration ;
    rdfs:range xsd:string ;
    rdfs:label "has test generation instruction"@en ;
    rdfs:comment "Step 4: the prompt instruction directing the AI to propose or verify test cases for the change."@en .

# § Review Observation — evidence that a configuration or process step was applied.

secav:ReviewObservation a owl:Class ;
    rdfs:subClassOf secav:Evidence ;
    rdfs:label "Review Observation"@en ;
    rdfs:comment "Evidence that a specific review configuration or process step (e.g., AIReviewPromptConfiguration) was applied and linked to a ReviewRecord."@en .

# § Risk-Based Triage — classification and escape tracking.

secav:ReviewRiskLevel a owl:DatatypeProperty ;
    rdfs:domain secav:EngineeringActivity ;
    rdfs:range xsd:string ;
    rdfs:label "review risk level"@en ;
    rdfs:comment "Risk classification assigned to a PR before routing: 'Routine', 'Attention', or 'SecurityCritical'. SecurityCritical triggers requiresHumanValidation."@en .

secav:ReviewEscapeObservation a owl:Class ;
    rdfs:subClassOf secav:DefectRecord ;
    rdfs:label "Review Escape Observation"@en ;
    rdfs:comment "A defect record documenting a false negative: a high-risk PR that passed a lower review tier than its risk level required."@en .

# § Pipeline Stages — deterministic and CI activities, and ordering.

secav:DeterministicAnalysisActivity a owl:Class ;
    rdfs:subClassOf secav:EngineeringActivity ;
    rdfs:label "Deterministic Analysis Activity"@en ;
    rdfs:comment "A pipeline stage that applies deterministic tools (linters, static scanners, formatters) before AI or human review passes."@en .

secav:ContinuousIntegrationActivity a owl:Class ;
    rdfs:subClassOf secav:EngineeringActivity ;
    rdfs:label "Continuous Integration Activity"@en ;
    rdfs:comment "A pipeline stage that runs automated tests and integration checks as the final gate before merge."@en .

secav:precedes a owl:ObjectProperty ;
    rdfs:domain secav:EngineeringActivity ;
    rdfs:range secav:EngineeringActivity ;
    rdfs:label "precedes"@en ;
    rdfs:comment "Expresses that one engineering activity must complete before the next begins, preserving pipeline stage order."@en .

# ---------------------------------------------------------------------------
# Organizational Change Adoption
# Derived from: coaching-governance/guides/ (Conductas Observables - Cambio Organizacional)
# Models the five adoption pillars, the seven observable adoption behaviors,
# adoption measurement methods, and the ChangeAgent stakeholder role.
# ---------------------------------------------------------------------------

# § Adoption Pillars — named dimensions of organizational adoption measurement.

secav:AdoptionPillar a owl:Class ;
    rdfs:label "Adoption Pillar"@en ;
    rdfs:comment "A named dimension used to categorize and measure observable adoption behaviors in an organizational change programme."@en .

secav:LeadershipModelingPillar a owl:Class ;
    rdfs:subClassOf secav:AdoptionPillar ;
    rdfs:label "Leadership Modeling Pillar"@en ;
    rdfs:comment "Leaders and PMs visibly use and publicly endorse the new way of working, legitimising the change and eliminating dual-process ambiguity."@en .

secav:EfficientCollaborationPillar a owl:Class ;
    rdfs:subClassOf secav:AdoptionPillar ;
    rdfs:label "Efficient Collaboration Pillar"@en ;
    rdfs:comment "Teams keep project documentation centralised and replace long status meetings with short, blocker-focused synchronisations."@en .

secav:OpenCommunicationPillar a owl:Class ;
    rdfs:subClassOf secav:AdoptionPillar ;
    rdfs:label "Open Communication Pillar"@en ;
    rdfs:comment "Team members surface doubts, errors, and bottlenecks early and transparently, enabling fast resolution without blame."@en .

secav:ContinuousAdaptabilityPillar a owl:Class ;
    rdfs:subClassOf secav:AdoptionPillar ;
    rdfs:label "Continuous Adaptability Pillar"@en ;
    rdfs:comment "All members autonomously apply guides and training materials before escalating basic queries, demonstrating self-directed learning."@en .

secav:FeedbackAndInnovationPillar a owl:Class ;
    rdfs:subClassOf secav:AdoptionPillar ;
    rdfs:label "Feedback and Innovation Pillar"@en ;
    rdfs:comment "All members contribute constructive suggestions in retrospective sessions, enabling real-time process adjustment based on direct experience."@en .

# § Observable Adoption Behaviors — concrete, measurable behaviors that
# evidence effective incorporation of a new way of working.
# Modeled as subclass of Evidence: each behavior is observable and provides
# evidence of ChangeAdaptabilityCompetency.

secav:AdoptionBehavior a owl:Class ;
    rdfs:subClassOf secav:Evidence ;
    rdfs:label "Adoption Behavior"@en ;
    rdfs:comment "A concrete, measurable behavior that evidences effective incorporation of a new way of working into the organizational culture."@en .

secav:LeaderDigitalToolAdoption a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Leader Digital Tool Adoption"@en ;
    rdfs:comment "Leaders and PMs use new digital tools as the primary communication channel, replacing traditional email and eliminating dual-process ambiguity."@en .

secav:PublicRecognitionOfNewBehaviors a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Public Recognition of New Behaviors"@en ;
    rdfs:comment "Leaders publicly recognise collaborators who apply new behaviors and methodologies, reinforcing desired culture and accelerating peer adoption."@en .

secav:CentralizedDocumentationPractice a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Centralized Documentation Practice"@en ;
    rdfs:comment "Teams maintain project documentation centralised and up-to-date in shared platforms, enabling visibility, async work, and avoiding duplication."@en .

secav:FocusedSynchronizationPractice a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Focused Synchronization Practice"@en ;
    rdfs:comment "Teams replace long follow-up meetings with brief synchronisations focused on blockers, optimising effective work time."@en .

secav:EarlyTransparentCommunication a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Early Transparent Communication"@en ;
    rdfs:comment "Team members express doubts, errors, and bottlenecks early and transparently, enabling fast problem resolution without blame assignment."@en .

secav:AutonomousGuideApplication a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Autonomous Guide Application"@en ;
    rdfs:comment "Members autonomously apply guides and training materials before escalating basic queries, demonstrating proactivity and reducing support overload."@en .

secav:ConstructiveRetrospectiveFeedback a owl:Class ;
    rdfs:subClassOf secav:AdoptionBehavior ;
    rdfs:label "Constructive Retrospective Feedback"@en ;
    rdfs:comment "Members contribute constructive suggestions about the new model in retrospective sessions, enabling real-time process adjustment."@en .

# § Adoption Measurement — methods for observing and tracking adoption behaviors.

secav:AdoptionMeasurement a owl:Class ;
    rdfs:subClassOf secav:Measurement ;
    rdfs:label "Adoption Measurement"@en ;
    rdfs:comment "A measurement of the degree to which adoption behaviors are present in a team or organization."@en .

secav:PulseSurveyMeasurement a owl:Class ;
    rdfs:subClassOf secav:AdoptionMeasurement ;
    rdfs:label "Pulse Survey Measurement"@en ;
    rdfs:comment "Brief biweekly or monthly pulse surveys (e.g., eNPS) used to measure adoption progress and cultural alignment."@en .

secav:DirectRitualObservation a owl:Class ;
    rdfs:subClassOf secav:AdoptionMeasurement ;
    rdfs:label "Direct Ritual Observation"@en ;
    rdfs:comment "Direct observation of team rituals (stand-ups, retrospectives, planning sessions) to detect the presence or absence of adoption behaviors."@en .

# § Change Adaptability Competency — the competency evidenced by adoption behaviors.

secav:ChangeAdaptabilityCompetency a owl:Class ;
    rdfs:subClassOf secav:Competency ;
    rdfs:label "Change Adaptability Competency"@en ;
    rdfs:comment "The competency to internalize, apply, and advocate for new ways of working within an organizational change programme."@en .

# § Change Agent — stakeholder who facilitates adoption.

secav:ChangeAgent a owl:Class ;
    rdfs:subClassOf secav:Stakeholder ;
    rdfs:label "Change Agent"@en ;
    rdfs:comment "A stakeholder — facilitator, leader, or PM — who actively models, advocates, and removes barriers for the adoption of a new way of working."@en .

# § New Object Properties

secav:belongsToPillar a owl:ObjectProperty ;
    rdfs:domain secav:AdoptionBehavior ;
    rdfs:range secav:AdoptionPillar ;
    rdfs:label "belongs to pillar"@en ;
    rdfs:comment "Links an adoption behavior to the adoption pillar it belongs to."@en .

secav:measuresAdoption a owl:ObjectProperty ;
    rdfs:domain secav:AdoptionMeasurement ;
    rdfs:range secav:AdoptionBehavior ;
    rdfs:label "measures adoption"@en ;
    rdfs:comment "Links an adoption measurement to the specific behavior it quantifies."@en .

secav:facilitatedBy a owl:ObjectProperty ;
    rdfs:domain secav:AdoptionBehavior ;
    rdfs:range secav:ChangeAgent ;
    rdfs:label "facilitated by"@en ;
    rdfs:comment "Links an adoption behavior to the change agent responsible for enabling its adoption."@en .

# § New Datatype Property

secav:adoptionTarget a owl:DatatypeProperty ;
    rdfs:domain secav:AdoptionBehavior ;
    rdfs:range xsd:string ;
    rdfs:label "adoption target"@en ;
    rdfs:comment "The organizational role expected to exhibit this behavior: 'leaders', 'teams', or 'all'."@en .

# ---------------------------------------------------------------------------
# Coach Observation Model
# Derived from: coaching-governance/guides/coach-observation-checklist.md
# Models the two types of field observations a coach records — positive
# behaviors and alert signals — across all eight engineering activity groups.
# ---------------------------------------------------------------------------

# § Coach Observation — an observable fact recorded during a coaching session.
# Subclass of Evidence: each observation provides direct empirical input
# for competency assessment or coaching intervention planning.

secav:CoachObservation a owl:Class ;
    rdfs:subClassOf secav:Evidence ;
    rdfs:label "Coach Observation"@en ;
    rdfs:comment "A concrete, directly observable fact recorded by a coach during a team session — something seen, heard, or read, not an inference."@en .

secav:PositiveBehaviorObservation a owl:Class ;
    rdfs:subClassOf secav:CoachObservation ;
    rdfs:label "Positive Behavior Observation"@en ;
    rdfs:comment "A coach observation of a desired engineering behavior that provides evidence of competency. Contributes to CompetencyAssessment."@en .

secav:AlertBehaviorObservation a owl:Class ;
    rdfs:subClassOf secav:CoachObservation ;
    rdfs:label "Alert Behavior Observation"@en ;
    rdfs:comment "A coach observation of a problematic or absent behavior that signals risk and triggers a coaching intervention."@en .

# § Observation Properties

secav:observedDuring a owl:ObjectProperty ;
    rdfs:domain secav:CoachObservation ;
    rdfs:range secav:EngineeringActivity ;
    rdfs:label "observed during"@en ;
    rdfs:comment "Links a coach observation to the engineering activity group in which it was recorded."@en .

secav:observationStatement a owl:DatatypeProperty ;
    rdfs:domain secav:CoachObservation ;
    rdfs:range xsd:string ;
    rdfs:label "observation statement"@en ;
    rdfs:comment "Verbatim description of the observable behavior — phrased in terms of what can be seen, heard, or read directly."@en .

secav:evidencesCompetency a owl:ObjectProperty ;
    rdfs:domain secav:PositiveBehaviorObservation ;
    rdfs:range secav:Competency ;
    rdfs:label "evidences competency"@en ;
    rdfs:comment "Links a positive observation to the competency it provides evidence for."@en .

secav:triggersIntervention a owl:ObjectProperty ;
    rdfs:domain secav:AlertBehaviorObservation ;
    rdfs:range secav:CoachingIntervention ;
    rdfs:label "triggers intervention"@en ;
    rdfs:comment "Links an alert observation to the coaching intervention it warrants."@en .
