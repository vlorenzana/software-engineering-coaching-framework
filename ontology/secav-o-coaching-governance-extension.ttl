@prefix secavo: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o-coaching-governance#> .
@prefix secav: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SECAV-O Coaching Governance Extension v0.3.0
# Extension namespace: https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o-coaching-governance#
# Core ontology namespace: https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#
#
# This ontology explicitly imports the SECAV-O core ontology.
# Extension-specific classes and properties use the secavo: prefix.
# Core classes (Competency, EngineeringActivity, Evidence, Artifact, CoachingIntervention,
# AcceptanceCriterion, PreventiveAction, QualityActivityRequirement) are referenced via the
# secav: prefix and must not be redeclared here.

<https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o-coaching-governance>
    a owl:Ontology ;
    owl:imports <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o> ;
    rdfs:label "SECAV-O Coaching Governance Extension"@en ;
    rdfs:comment "Extends the SECAV-O core model with team inception/launch coaching, member preparation and onboarding, annual/sprint coaching planning, risk governance, institutional alignment, ethics, measurement, retrospectives and longitudinal competency growth."@en .

### Core-aligned planning classes
secavo:AnnualCoachingPlan a owl:Class ; rdfs:label "Annual Coaching Plan"@en .
secavo:CoachingSprint a owl:Class ; rdfs:label "Coaching Sprint"@en .
secavo:SprintPlan a owl:Class ; rdfs:label "Sprint Plan"@en .
secavo:SprintRetrospective a owl:Class ; rdfs:label "Sprint Retrospective"@en .
secavo:CoachingObjective a owl:Class ; rdfs:label "Coaching Objective"@en .
secavo:Baseline a owl:Class ; rdfs:label "Baseline"@en ; rdfs:subClassOf secav:Evidence .
secavo:CompetencyTrend a owl:Class ; rdfs:label "Competency Trend"@en ; rdfs:subClassOf secav:Evidence .
secavo:ImprovementAction a owl:Class ; rdfs:label "Improvement Action"@en ; rdfs:subClassOf secav:CoachingIntervention .

### Measurement/evidence classes aligned to SECAV-O Evidence
secavo:Metric a owl:Class ; rdfs:label "Metric"@en .
secavo:MeasurementObservation a owl:Class ; rdfs:label "Measurement Observation"@en ; rdfs:subClassOf secav:Evidence .
secavo:DefectObservation a owl:Class ; rdfs:label "Defect Observation"@en ; rdfs:subClassOf secavo:MeasurementObservation .
secavo:ReviewMeasurementObservation a owl:Class ;
    rdfs:label "Review Measurement Observation"@en ;
    rdfs:subClassOf secavo:MeasurementObservation ;
    rdfs:comment "A measurement observation that quantifies review activity metrics (e.g. review frequency, defect detection rate). Distinct from secav:ReviewObservation, which records that a specific review configuration step was applied."@en .
secavo:UnitTestObservation a owl:Class ; rdfs:label "Unit Test Observation"@en ; rdfs:subClassOf secavo:MeasurementObservation .

### Governance classes
secavo:InstitutionalObjective a owl:Class ; rdfs:label "Institutional Objective"@en .
secavo:Risk a owl:Class ; rdfs:label "Risk"@en .
secavo:CorrectiveAction a owl:Class ; rdfs:label "Corrective / Contingency Action"@en .
secavo:CoachEthicsCode a owl:Class ; rdfs:label "Coach Ethics Code"@en .
secavo:EthicsAcknowledgement a owl:Class ; rdfs:label "Coach Ethics Acknowledgement"@en ; rdfs:subClassOf secav:Evidence .

### Planning relationships
secavo:hasObjective a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:CoachingObjective ;
  rdfs:label "has objective"@en .
secavo:hasSprint a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:CoachingSprint ;
  rdfs:label "has sprint"@en .
secavo:hasSprintPlan a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:SprintPlan ;
  rdfs:label "has sprint plan"@en .
secavo:producesRetrospective a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:SprintRetrospective ;
  rdfs:label "produces retrospective"@en .
secavo:updatesPlan a owl:ObjectProperty ;
  rdfs:domain secavo:SprintRetrospective ; rdfs:range secavo:AnnualCoachingPlan ;
  rdfs:label "updates plan"@en .

### Alignment to SECAV-O competency/activity/evidence model
secavo:targetsCompetency a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingObjective ; rdfs:range secav:Competency ;
  rdfs:label "targets competency (objective)"@en ;
  rdfs:comment "Links a coaching objective to the competency it aims to develop. Distinct from secav:targetsCompetency, whose domain is CoachingIntervention."@en .
secavo:observesActivity a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secav:EngineeringActivity ;
  rdfs:label "observes activity"@en .
secavo:usesArtifactEvidence a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secav:Artifact ;
  rdfs:label "uses artifact evidence"@en .
secavo:usesAcceptanceCriteria a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secav:AcceptanceCriterion ;
  rdfs:label "uses acceptance criteria"@en .
secavo:collectsEvidence a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secav:Evidence ;
  rdfs:label "collects evidence"@en .
secavo:collectsMetric a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:Metric ;
  rdfs:label "collects metric"@en .
secavo:producesObservation a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:MeasurementObservation ;
  rdfs:label "produces observation"@en .
secavo:hasBaseline a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:Baseline ;
  rdfs:label "has baseline"@en .
secavo:comparesToBaseline a owl:ObjectProperty ;
  rdfs:domain secavo:MeasurementObservation ; rdfs:range secavo:Baseline ;
  rdfs:label "compares to baseline"@en .
secavo:evaluatesCompetency a owl:ObjectProperty ;
  rdfs:domain secavo:MeasurementObservation ; rdfs:range secav:Competency ;
  rdfs:label "evaluates competency"@en .
secavo:tracksTrend a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:CompetencyTrend ;
  rdfs:label "tracks trend"@en .
secavo:identifiesGap a owl:ObjectProperty ;
  rdfs:domain secavo:MeasurementObservation ;
  rdfs:range secav:Competency ;
  rdfs:label "identifies gap"@en .
secavo:triggersImprovementAction a owl:ObjectProperty ;
  rdfs:domain secavo:MeasurementObservation ; rdfs:range secavo:ImprovementAction ;
  rdfs:label "triggers improvement action"@en .
secavo:implementsCoachingIntervention a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secav:CoachingIntervention ;
  rdfs:label "implements coaching intervention"@en .

### Institutional alignment
secavo:alignsWithInstitutionalObjective a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingObjective ; rdfs:range secavo:InstitutionalObjective ;
  rdfs:label "aligns with institutional objective"@en .
secavo:contributesToInstitutionalObjective a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:InstitutionalObjective ;
  rdfs:label "contributes to institutional objective"@en .

### Risk governance
secavo:hasRisk a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:Risk ;
  rdfs:label "has risk"@en .
secavo:sprintHasRisk a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingSprint ; rdfs:range secavo:Risk ;
  rdfs:label "sprint has risk"@en .
secavo:hasPreventiveAction a owl:ObjectProperty ;
  rdfs:domain secavo:Risk ; rdfs:range secav:PreventiveAction ;
  rdfs:label "has preventive action"@en .
secavo:hasCorrectiveAction a owl:ObjectProperty ;
  rdfs:domain secavo:Risk ; rdfs:range secavo:CorrectiveAction ;
  rdfs:label "has corrective action"@en .
secavo:reviewedInRetrospective a owl:ObjectProperty ;
  rdfs:domain secavo:Risk ; rdfs:range secavo:SprintRetrospective ;
  rdfs:label "reviewed in retrospective"@en .
secavo:riskRelatedToObjective a owl:ObjectProperty ;
  rdfs:domain secavo:Risk ; rdfs:range secavo:CoachingObjective ;
  rdfs:label "risk related to objective"@en .

### Ethics governance
secavo:governedByEthicsCode a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:CoachEthicsCode ;
  rdfs:label "governed by ethics code"@en .
secavo:hasEthicsAcknowledgement a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:EthicsAcknowledgement ;
  rdfs:label "has ethics acknowledgement"@en .
secavo:acknowledgesEthicsCode a owl:ObjectProperty ;
  rdfs:domain secavo:EthicsAcknowledgement ; rdfs:range secavo:CoachEthicsCode ;
  rdfs:label "acknowledges ethics code"@en .

### Datatype properties
secavo:baselineValue a owl:DatatypeProperty ;
  rdfs:domain secavo:Baseline ; rdfs:range rdfs:Literal ;
  rdfs:label "baseline value"@en .
secavo:targetValue a owl:DatatypeProperty ;
  rdfs:domain secavo:Baseline ; rdfs:range rdfs:Literal ;
  rdfs:label "target value"@en .
secavo:observedValue a owl:DatatypeProperty ;
  rdfs:domain secavo:MeasurementObservation ; rdfs:range rdfs:Literal ;
  rdfs:label "observed value"@en .
secavo:competencyLevel a owl:DatatypeProperty ;
  rdfs:domain secavo:Baseline ; rdfs:range xsd:string ;
  rdfs:label "competency level"@en .
secavo:phaseInjected a owl:DatatypeProperty ;
  rdfs:domain secavo:DefectObservation ; rdfs:range xsd:string ;
  rdfs:label "phase injected"@en .
secavo:phaseDetected a owl:DatatypeProperty ;
  rdfs:domain secavo:DefectObservation ; rdfs:range xsd:string ;
  rdfs:label "phase detected"@en .
secavo:detectionMethod a owl:DatatypeProperty ;
  rdfs:domain secavo:DefectObservation ; rdfs:range xsd:string ;
  rdfs:label "detection method"@en .
secavo:riskProbability a owl:DatatypeProperty ;
  rdfs:domain secavo:Risk ; rdfs:range xsd:decimal ;
  rdfs:label "risk probability"@en ;
  rdfs:comment "Probability score for a coaching programme risk as a decimal value. Intentionally distinct from secav:riskProbability, which uses an integer 1–5 scale for software project risks."@en .
secavo:riskImpact a owl:DatatypeProperty ;
  rdfs:domain secavo:Risk ; rdfs:range xsd:decimal ;
  rdfs:label "risk impact"@en ;
  rdfs:comment "Impact score for a coaching programme risk as a decimal value. Intentionally distinct from secav:riskImpact, which uses an integer 1–5 scale for software project risks."@en .
secavo:riskStatus a owl:DatatypeProperty ;
  rdfs:domain secavo:Risk ; rdfs:range xsd:string ;
  rdfs:label "risk status"@en .
secavo:riskOwner a owl:ObjectProperty ;
  rdfs:domain secavo:Risk ; rdfs:range secav:Stakeholder ;
  rdfs:label "risk owner"@en .
secavo:retrospectiveDate a owl:DatatypeProperty ;
  rdfs:domain secavo:SprintRetrospective ; rdfs:range xsd:date ;
  rdfs:label "retrospective date"@en .
secavo:ethicalCommitmentDate a owl:DatatypeProperty ;
  rdfs:domain secavo:EthicsAcknowledgement ; rdfs:range xsd:date ;
  rdfs:label "ethical commitment date"@en .


### Team lifecycle and onboarding classes
secavo:Team a owl:Class ; rdfs:label "Team"@en .
secavo:Project a owl:Class ; rdfs:label "Project"@en .
secavo:TeamCoachingInitiation a owl:Class ; rdfs:label "Team Coaching Initiation / Launch"@en ; rdfs:subClassOf secav:CoachingIntervention .
secavo:MemberPreparation a owl:Class ; rdfs:label "Member Preparation"@en ; rdfs:subClassOf secav:CoachingIntervention .
secavo:MemberOnboarding a owl:Class ; rdfs:label "Member Onboarding"@en ; rdfs:subClassOf secav:CoachingIntervention .
secavo:ProjectContext a owl:Class ; rdfs:label "Project Context"@en .
secavo:ProjectObjective a owl:Class ; rdfs:label "Project Objective"@en .
secavo:MemberBaseline a owl:Class ; rdfs:label "Member Growth Baseline"@en ; rdfs:subClassOf secavo:Baseline .

### Team lifecycle relationships
secavo:initiatesCoachingForTeam a owl:ObjectProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range secavo:Team ;
  rdfs:label "initiates coaching for team"@en .
secavo:relatesToProject a owl:ObjectProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range secavo:Project ;
  rdfs:label "relates to project"@en .
secavo:providesProjectContext a owl:ObjectProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range secavo:ProjectContext ;
  rdfs:label "provides project context"@en .
secavo:preparesMemberForActivity a owl:ObjectProperty ;
  rdfs:domain secavo:MemberPreparation ; rdfs:range secav:EngineeringActivity ;
  rdfs:label "prepares member for activity"@en .
secavo:preparesMemberForCompetency a owl:ObjectProperty ;
  rdfs:domain secavo:MemberPreparation ; rdfs:range secav:Competency ;
  rdfs:label "prepares member for competency"@en .
secavo:onboardsMemberToTeam a owl:ObjectProperty ;
  rdfs:domain secavo:MemberOnboarding ; rdfs:range secavo:Team ;
  rdfs:label "onboards member to team"@en .
secavo:communicatesObjective a owl:ObjectProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range secavo:ProjectObjective ;
  rdfs:label "communicates objective"@en .
secavo:communicatesRisk a owl:ObjectProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range secavo:Risk ;
  rdfs:label "communicates risk"@en .
secavo:establishesMemberBaseline a owl:ObjectProperty ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( secavo:TeamCoachingInitiation secavo:MemberOnboarding ) ] ;
  rdfs:range secavo:MemberBaseline ;
  rdfs:label "establishes member baseline"@en .
secavo:baselineForCompetency a owl:ObjectProperty ;
  rdfs:domain secavo:MemberBaseline ; rdfs:range secav:Competency ;
  rdfs:label "baseline for competency"@en .
secavo:alignsWithProjectObjective a owl:ObjectProperty ;
  rdfs:domain secavo:CoachingObjective ; rdfs:range secavo:ProjectObjective ;
  rdfs:label "aligns with project objective"@en .
secavo:supportsTeamLifecycle a owl:ObjectProperty ;
  rdfs:domain secavo:AnnualCoachingPlan ; rdfs:range secavo:Team ;
  rdfs:label "supports team lifecycle"@en .
secavo:updatesMemberBaseline a owl:ObjectProperty ;
  rdfs:domain secavo:MeasurementObservation ; rdfs:range secavo:MemberBaseline ;
  rdfs:label "updates member baseline"@en .

### Lifecycle datatypes
secavo:teamLaunchDate a owl:DatatypeProperty ;
  rdfs:domain secavo:TeamCoachingInitiation ; rdfs:range xsd:date ;
  rdfs:label "team launch date"@en .
secavo:memberJoinDate a owl:DatatypeProperty ;
  rdfs:domain secavo:MemberOnboarding ; rdfs:range xsd:date ;
  rdfs:label "member join date"@en .
secavo:preparationStatus a owl:DatatypeProperty ;
  rdfs:domain secavo:MemberPreparation ; rdfs:range xsd:string ;
  rdfs:label "preparation status"@en .

### Project planning participation, quality advocacy, dissent and escalation
secavo:ProjectPlanningParticipation a owl:Class ;
  rdfs:label "Project Planning Participation"@en ;
  rdfs:subClassOf secav:CoachingIntervention .
secavo:PlanningDecision a owl:Class ; rdfs:label "Planning Decision"@en .
secavo:QualityPlanningConcern a owl:Class ; rdfs:label "Quality Planning Concern"@en ; rdfs:subClassOf secav:Evidence .
secavo:FormalDissent a owl:Class ; rdfs:label "Formal Quality Dissent"@en ; rdfs:subClassOf secav:Evidence .
secavo:Escalation a owl:Class ; rdfs:label "Quality Governance Escalation"@en ; rdfs:subClassOf secav:CoachingIntervention .
secavo:GovernanceDecision a owl:Class ; rdfs:label "Governance Decision"@en ; rdfs:subClassOf secav:Evidence .

secavo:participatesInProjectPlanning a owl:ObjectProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range secavo:Project ;
  rdfs:label "participates in project planning"@en .
secavo:hasPlanningDecision a owl:ObjectProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range secavo:PlanningDecision ;
  rdfs:label "has planning decision"@en .
secavo:requiresQualityActivity a owl:ObjectProperty ;
  rdfs:domain secav:QualityActivityRequirement ; rdfs:range secav:EngineeringActivity ;
  rdfs:label "requires quality activity"@en .
secavo:planningDecisionAffectsActivity a owl:ObjectProperty ;
  rdfs:domain secavo:PlanningDecision ; rdfs:range secav:EngineeringActivity ;
  rdfs:label "planning decision affects activity"@en .
secavo:raisesQualityConcern a owl:ObjectProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range secavo:QualityPlanningConcern ;
  rdfs:label "raises quality concern"@en .
secavo:concernAboutDecision a owl:ObjectProperty ;
  rdfs:domain secavo:QualityPlanningConcern ; rdfs:range secavo:PlanningDecision ;
  rdfs:label "concern about decision"@en .
secavo:concernAboutOmittedActivity a owl:ObjectProperty ;
  rdfs:domain secavo:QualityPlanningConcern ; rdfs:range secav:EngineeringActivity ;
  rdfs:label "concern about omitted activity"@en .
secavo:recordsFormalDissent a owl:ObjectProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range secavo:FormalDissent ;
  rdfs:label "records formal dissent"@en .
secavo:dissentAboutConcern a owl:ObjectProperty ;
  rdfs:domain secavo:FormalDissent ; rdfs:range secavo:QualityPlanningConcern ;
  rdfs:label "dissent about concern"@en .
secavo:escalatesConcern a owl:ObjectProperty ;
  rdfs:domain secavo:Escalation ; rdfs:range secavo:QualityPlanningConcern ;
  rdfs:label "escalates concern"@en .
secavo:resultsInGovernanceDecision a owl:ObjectProperty ;
  rdfs:domain secavo:Escalation ; rdfs:range secavo:GovernanceDecision ;
  rdfs:label "results in governance decision"@en .
secavo:reviewedAsPlanningDecisionInRetrospective a owl:ObjectProperty ;
  rdfs:domain secavo:PlanningDecision ; rdfs:range secavo:SprintRetrospective ;
  rdfs:label "reviewed as planning decision in retrospective"@en .
secavo:createsRisk a owl:ObjectProperty ;
  rdfs:domain secavo:QualityPlanningConcern ; rdfs:range secavo:Risk ;
  rdfs:label "creates risk"@en .
secavo:recommendsPreventiveAction a owl:ObjectProperty ;
  rdfs:domain secavo:QualityPlanningConcern ; rdfs:range secav:PreventiveAction ;
  rdfs:label "recommends preventive action"@en .

secavo:participationMode a owl:DatatypeProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range xsd:string ;
  rdfs:label "participation mode"@en .
secavo:hasVotingRight a owl:DatatypeProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range xsd:boolean ;
  rdfs:label "has voting right"@en .
secavo:mayRaiseFormalDissent a owl:DatatypeProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range xsd:boolean ;
  rdfs:label "may raise formal dissent"@en .
secavo:mayEscalate a owl:DatatypeProperty ;
  rdfs:domain secavo:ProjectPlanningParticipation ; rdfs:range xsd:boolean ;
  rdfs:label "may escalate"@en .
secavo:decisionRationale a owl:DatatypeProperty ;
  rdfs:domain secavo:PlanningDecision ; rdfs:range xsd:string ;
  rdfs:label "decision rationale"@en .
secavo:escalationLevel a owl:DatatypeProperty ;
  rdfs:domain secavo:Escalation ; rdfs:range xsd:string ;
  rdfs:label "escalation level"@en .
secavo:riskDisposition a owl:DatatypeProperty ;
  rdfs:domain secavo:GovernanceDecision ; rdfs:range xsd:string ;
  rdfs:label "risk disposition"@en .