@prefix secav: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Initial governance/data-quality shapes.
# These constraints validate RDF data structure. They do not claim empirical
# validation of the coaching methodology.

secav:EngineeringActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:EngineeringActivity ;
    sh:property [
        sh:path secav:requiresCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "An engineering activity should identify at least one required competency."@en
    ] .

secav:ReviewActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:ReviewActivity ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A review activity should identify the artifact it evaluates."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "Every peer review, walkthrough, or inspection must record at least one finding — including an explicit 'no defects found' record when the artifact is clean."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "Every review activity requires a coach process sign-off confirming the session was conducted acceptably before its findings are valid for competency assessment."@en
    ] .

secav:CoachReviewSignOffShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachReviewSignOff ;
    sh:property [
        sh:path secav:signOffStatement ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A coach review sign-off must include a statement confirming the process was conducted acceptably."@en
    ] ;
    sh:property [
        sh:path secav:signOffDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A coach review sign-off must record the date of approval."@en
    ] .

secav:AIAssistedActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:AIAssistedActivity ;
    sh:property [
        sh:path secav:assistedByAI ;
        sh:minCount 1 ;
        sh:class secav:AISystem ;
        sh:message "An AI-assisted activity must identify the AI system involved."@en
    ] ;
    sh:property [
        sh:path secav:requiresHumanValidation ;
        sh:minCount 1 ;
        sh:class secav:HumanValidationActivity ;
        sh:message "In this prototype governance profile, an AI-assisted activity must identify a human-validation activity."@en
    ] .

secav:CompetencyAssessmentShape
    a sh:NodeShape ;
    sh:targetClass secav:CompetencyAssessment ;
    sh:property [
        sh:path secav:basedOnEvidence ;
        sh:minCount 1 ;
        sh:class secav:Evidence ;
        sh:message "A competency assessment must be based on at least one item of observable evidence."@en
    ] ;
    sh:property [
        sh:path secav:assessesCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A competency assessment must identify the competency being assessed."@en
    ] .

secav:CoachingInterventionShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachingIntervention ;
    sh:property [
        sh:path secav:targetsCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A coaching intervention should identify the competency it targets."@en
    ] .

secav:ReviewAntipatternShape
    a sh:NodeShape ;
    sh:targetClass secav:ReviewAntipattern ;
    sh:property [
        sh:path secav:triggers ;
        sh:minCount 1 ;
        sh:class secav:CoachingIntervention ;
        sh:message "A review antipattern should trigger at least one coaching intervention."@en
    ] .

secav:RubberStampApprovalShape
    a sh:NodeShape ;
    sh:targetClass secav:RubberStampApproval ;
    sh:property [
        sh:path secav:providesEvidenceOf ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A rubber-stamp approval must identify the review competency gap it evidences."@en
    ] .

secav:FormalReviewRequestShape
    a sh:NodeShape ;
    sh:targetClass secav:FormalReviewRequest ;
    sh:property [
        sh:path secav:requestDescription ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A formal review request must include a description of what changed, why, and the acceptance criteria."@en
    ] .

secav:AutomationGateShape
    a sh:NodeShape ;
    sh:targetClass secav:AutomationGate ;
    sh:property [
        sh:path secav:criterionStatement ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An automation gate must have a criterion statement describing what condition is enforced."@en
    ] .

secav:AcceptanceCriteriaDefinitionShape
    a sh:NodeShape ;
    sh:targetClass secav:AcceptanceCriteriaDefinition ;
    sh:property [
        sh:path secav:produces ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "An acceptance criteria definition activity must produce at least one artifact (e.g., a test specification or BDD scenario document)."@en
    ] .

secav:SelfReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:SelfReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A self-review must identify the artifact the engineer evaluated before submitting the formal review request."@en
    ] .

secav:AIReviewPromptConfigurationShape
    a sh:NodeShape ;
    sh:targetClass secav:AIReviewPromptConfiguration ;
    sh:property [
        sh:path secav:hasContextDefinition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a context definition (step 1)."@en
    ] ;
    sh:property [
        sh:path secav:hasImpactAnalysisInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include an impact analysis instruction (step 2)."@en
    ] ;
    sh:property [
        sh:path secav:hasSecurityEvaluationInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a security evaluation instruction (step 3)."@en
    ] ;
    sh:property [
        sh:path secav:hasTestGenerationInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a test generation instruction (step 4)."@en
    ] .

secav:AdoptionBehaviorShape
    a sh:NodeShape ;
    sh:targetClass secav:AdoptionBehavior ;
    sh:property [
        sh:path secav:belongsToPillar ;
        sh:minCount 1 ;
        sh:class secav:AdoptionPillar ;
        sh:message "An adoption behavior must belong to at least one adoption pillar."@en
    ] .

secav:CoachObservationShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachObservation ;
    sh:property [
        sh:path secav:observedDuring ;
        sh:minCount 1 ;
        sh:class secav:EngineeringActivity ;
        sh:message "A coach observation must be linked to the engineering activity during which it was recorded."@en
    ] ;
    sh:property [
        sh:path secav:observationStatement ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A coach observation must include a verbatim statement of what was observed."@en
    ] .

secav:LeaderBehaviorShape
    a sh:NodeShape ;
    sh:targetClass secav:LeaderBehavior ;
    sh:property [
        sh:path secav:belongsToDimension ;
        sh:minCount 1 ;
        sh:class secav:TechnicalLeadershipDimension ;
        sh:message "A leader behavior must belong to at least one technical leadership dimension."@en
    ] .

secav:MeetingMinutesShape
    a sh:NodeShape ;
    sh:targetClass secav:MeetingMinutes ;
    sh:property [
        sh:path secav:hasParticipant ;
        sh:minCount 1 ;
        sh:class secav:Stakeholder ;
        sh:message "Meeting minutes must record at least one participant (name and role). Minutes without participants cannot be traced to any attendee."@en
    ] ;
    sh:property [
        sh:path secav:meetingTopicSummary ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Meeting minutes must record at least one topic discussed with its outcome or decision."@en
    ] ;
    sh:property [
        sh:path secav:hasAgreement ;
        sh:minCount 1 ;
        sh:class secav:MeetingAgreement ;
        sh:message "Meeting minutes must record at least one agreement with an identified owner and an explicit due date."@en
    ] .

secav:MeetingAgreementShape
    a sh:NodeShape ;
    sh:targetClass secav:MeetingAgreement ;
    sh:property [
        sh:path secav:agreementOwner ;
        sh:minCount 1 ;
        sh:class secav:Stakeholder ;
        sh:message "A meeting agreement must have an identified owner."@en
    ] ;
    sh:property [
        sh:path secav:agreementDueDate ;
        sh:minCount 1 ;
        sh:datatype xsd:date ;
        sh:message "A meeting agreement must have an explicit due date. An agreement without a date is not a real commitment."@en
    ] .

secav:ProjectRiskShape
    a sh:NodeShape ;
    sh:targetClass secav:ProjectRisk ;
    sh:property [
        sh:path secav:riskProbability ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:message "A project risk must have a probability score between 1 and 5."@en
    ] ;
    sh:property [
        sh:path secav:riskImpact ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:message "A project risk must have an impact score between 1 and 5."@en
    ] ;
    sh:property [
        sh:path secav:riskOwner ;
        sh:minCount 1 ;
        sh:class secav:Stakeholder ;
        sh:message "A project risk must have an identified owner."@en
    ] ;
    sh:property [
        sh:path secav:hasResponsePlan ;
        sh:minCount 1 ;
        sh:class secav:RiskResponsePlan ;
        sh:message "A project risk must have at least one response plan (prevention + contingency)."@en
    ] .

secav:RiskResponsePlanShape
    a sh:NodeShape ;
    sh:targetClass secav:RiskResponsePlan ;
    sh:property [
        sh:path secav:preventionAction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A risk response plan must describe the prevention action."@en
    ] .

secav:RequirementsReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:RequirementsReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:RequirementsArtifact ;
        sh:message "A requirements review must identify the requirements artifact being reviewed."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "A requirements review must be endorsed by the coach before implementation begins on the reviewed requirements."@en
    ] .

secav:UnitTestDesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:UnitTestDesignReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:UnitTestDesignArtifact ;
        sh:message "A unit test design review must identify the test artifact being reviewed — test code is a work product requiring individual peer review, not just CI execution."@en
    ] .

secav:CriticalUnitTestShape
    a sh:NodeShape ;
    sh:targetClass secav:CriticalUnitTest ;
    sh:property [
        sh:path secav:requiresCompetency ;
        sh:minCount 1 ;
        sh:class secav:ReviewCompetency ;
        sh:message "A critical unit test must be linked to a review competency — it requires formal peer review (walkthrough or inspection) before merging, not only automated gate execution."@en
    ] .

secav:DesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:DesignReview ;
    sh:property [
        sh:path secav:designMaturityLevel ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A design review must declare the design maturity level ('exploratory', 'conceptual', or 'final') so participants frame feedback appropriately."@en
    ] ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A design review must identify the artifact (prototype, wireframe, or specification) being evaluated."@en
    ] .

secav:CodeWalkthroughShape
    a sh:NodeShape ;
    sh:targetClass secav:CodeWalkthrough ;
    sh:property [
        sh:path secav:walkthroughFocus ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A code walkthrough must declare its focus (e.g., 'architecture', 'logic', 'security', 'concurrency', 'knowledge-transfer')."@en
    ] ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A code walkthrough must identify the artifact (source file, module, or PR) it reviews."@en
    ] .

secav:IntegrationTestDesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:IntegrationTestDesignReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:IntegrationTestDesignArtifact ;
        sh:message "An integration test design review must identify the integration test artifact being reviewed."@en
    ] .

secav:SystemTestDesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:SystemTestDesignReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:SystemTestDesignArtifact ;
        sh:message "A system test design review must identify the system test artifact being reviewed."@en
    ] .

secav:AcceptanceTestDesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:AcceptanceTestDesignReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:AcceptanceTestDesignArtifact ;
        sh:message "An acceptance test design review must identify the acceptance test artifact being reviewed."@en
    ] .

secav:UnitTestResultsReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:UnitTestResultsReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:TestExecutionResultArtifact ;
        sh:message "A unit test results review must identify the test execution result artifact (report) being reviewed."@en
    ] .

secav:IntegrationTestResultsReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:IntegrationTestResultsReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:TestExecutionResultArtifact ;
        sh:message "An integration test results review must identify the test execution result artifact being reviewed."@en
    ] .

secav:SystemTestResultsReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:SystemTestResultsReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:TestExecutionResultArtifact ;
        sh:message "A system test results review must identify the test execution result artifact being reviewed."@en
    ] .

secav:AcceptanceTestResultsReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:AcceptanceTestResultsReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:TestExecutionResultArtifact ;
        sh:message "An acceptance test results review must identify the test execution result artifact being reviewed. This is the final quality gate before production deployment."@en
    ] .

secav:HighLevelDesignReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:HighLevelDesignReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:HighLevelDesignArtifact ;
        sh:message "A high-level design review must identify the architecture artifact being reviewed — component diagram, ADR collection, or equivalent."@en
    ] .

secav:FormalInspectionShape
    a sh:NodeShape ;
    sh:targetClass secav:FormalInspection ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A formal inspection must identify the artifact under inspection."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "A formal inspection must record at least one finding — including an explicit 'no defects found' record when the artifact is clean. Causal analysis of findings is required for process improvement."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "A formal inspection must be certified by a coach sign-off confirming that the session was conducted with proper roles (Moderator, Reader, Inspectors, Scribe), entry criteria met, and all findings recorded."@en
    ] .

secav:ReleaseReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:ReleaseReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:ReleaseArtifact ;
        sh:message "A release review must identify the release artifact package (release notes, deployment plan, rollback procedure) being reviewed."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "A release review must record at least one finding — including an explicit 'release approved, all quality gates confirmed' when no blocking issues remain."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "A release review must be certified by a coach sign-off confirming that all quality gates were verified and the release readiness assessment was conducted acceptably."@en
    ] .

secav:PlanningReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:PlanningReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:PlanningArtifact ;
        sh:message "A planning review must identify the plan artifact being reviewed (sprint plan, iteration plan, or work breakdown)."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "A planning review must record at least one finding — including an explicit 'plan approved, all mandatory review activities scheduled' when requirements are met."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "A planning review must be certified by a coach sign-off confirming the plan contains all mandatory quality gates before the sprint is authorized to begin (Code of Ethics, Principle 17)."@en
    ] .

secav:DesignWalkthroughShape
    a sh:NodeShape ;
    sh:targetClass secav:DesignWalkthrough ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:DesignArtifact ;
        sh:message "A design walkthrough must identify the design artifact (wireframe, prototype, diagram, or specification) being walked through."@en
    ] ;
    sh:property [
        sh:path secav:walkthroughFocus ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A design walkthrough must declare its review focus (e.g., 'usability', 'architecture', 'data-model', 'interaction-flow')."@en
    ] .

secav:WalkthroughExecutionShape
    a sh:NodeShape ;
    sh:targetClass secav:WalkthroughExecution ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A walkthrough execution must identify the artifact being walked through in the live session."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "A walkthrough execution must record all findings captured during the live session — including an explicit 'no defects found' record when the artifact is clean."@en
    ] .

secav:WalkthroughReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:WalkthroughReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A walkthrough review must identify the artifact whose findings are being verified — the same artifact reviewed in the walkthrough execution."@en
    ] ;
    sh:property [
        sh:path secav:producesReviewFinding ;
        sh:minCount 1 ;
        sh:class secav:ReviewFinding ;
        sh:message "A walkthrough review must record the follow-up state of each finding from the walkthrough execution — confirming corrections were adequate or flagging remaining issues."@en
    ] ;
    sh:property [
        sh:path secav:hasSignOff ;
        sh:minCount 1 ;
        sh:class secav:CoachReviewSignOff ;
        sh:message "The walkthrough lifecycle closes with a coach sign-off issued during the walkthrough review, confirming all findings were addressed."@en
    ] .

secav:CoachAbsenceRecordShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachAbsenceRecord ;
    sh:property [
        sh:path secav:absenceReason ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A coach absence record must state the reason for absence. Undocumented absence provides no basis for determining what occurred in the session."@en
    ] ;
    sh:property [
        sh:path secav:absenceConsequence ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A coach absence record must document the consequence: for review activities 'no sign-off issued, findings provisional'; for other activities 'no observation recorded'."@en
    ] .
