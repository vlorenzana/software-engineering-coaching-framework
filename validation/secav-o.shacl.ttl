@prefix secav: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Initial governance/data-quality shapes.
# These constraints validate RDF data structure. They do not claim empirical
# validation of the coaching methodology.

secav:EngineeringActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:EngineeringActivity ;
    sh:property [
        sh:path secav:requiresCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "An engineering activity should identify at least one required competency."@en
    ] .

secav:ReviewActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:ReviewActivity ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A review activity should identify the artifact it evaluates."@en
    ] .

secav:AIAssistedActivityShape
    a sh:NodeShape ;
    sh:targetClass secav:AIAssistedActivity ;
    sh:property [
        sh:path secav:assistedByAI ;
        sh:minCount 1 ;
        sh:class secav:AISystem ;
        sh:message "An AI-assisted activity must identify the AI system involved."@en
    ] ;
    sh:property [
        sh:path secav:requiresHumanValidation ;
        sh:minCount 1 ;
        sh:class secav:HumanValidationActivity ;
        sh:message "In this prototype governance profile, an AI-assisted activity must identify a human-validation activity."@en
    ] .

secav:CompetencyAssessmentShape
    a sh:NodeShape ;
    sh:targetClass secav:CompetencyAssessment ;
    sh:property [
        sh:path secav:basedOnEvidence ;
        sh:minCount 1 ;
        sh:class secav:Evidence ;
        sh:message "A competency assessment must be based on at least one item of observable evidence."@en
    ] ;
    sh:property [
        sh:path secav:assessesCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A competency assessment must identify the competency being assessed."@en
    ] .

secav:CoachingInterventionShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachingIntervention ;
    sh:property [
        sh:path secav:targetsCompetency ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A coaching intervention should identify the competency it targets."@en
    ] .

secav:ReviewAntipatternShape
    a sh:NodeShape ;
    sh:targetClass secav:ReviewAntipattern ;
    sh:property [
        sh:path secav:triggers ;
        sh:minCount 1 ;
        sh:class secav:CoachingIntervention ;
        sh:message "A review antipattern should trigger at least one coaching intervention."@en
    ] .

secav:RubberStampApprovalShape
    a sh:NodeShape ;
    sh:targetClass secav:RubberStampApproval ;
    sh:property [
        sh:path secav:providesEvidenceOf ;
        sh:minCount 1 ;
        sh:class secav:Competency ;
        sh:message "A rubber-stamp approval must identify the review competency gap it evidences."@en
    ] .

secav:FormalReviewRequestShape
    a sh:NodeShape ;
    sh:targetClass secav:FormalReviewRequest ;
    sh:property [
        sh:path secav:requestDescription ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A formal review request must include a description of what changed, why, and the acceptance criteria."@en
    ] .

secav:AutomationGateShape
    a sh:NodeShape ;
    sh:targetClass secav:AutomationGate ;
    sh:property [
        sh:path secav:criterionStatement ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An automation gate must have a criterion statement describing what condition is enforced."@en
    ] .

secav:AcceptanceCriteriaDefinitionShape
    a sh:NodeShape ;
    sh:targetClass secav:AcceptanceCriteriaDefinition ;
    sh:property [
        sh:path secav:produces ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "An acceptance criteria definition activity must produce at least one artifact (e.g., a test specification or BDD scenario document)."@en
    ] .

secav:SelfReviewShape
    a sh:NodeShape ;
    sh:targetClass secav:SelfReview ;
    sh:property [
        sh:path secav:evaluates ;
        sh:minCount 1 ;
        sh:class secav:Artifact ;
        sh:message "A self-review must identify the artifact the engineer evaluated before submitting the formal review request."@en
    ] .

secav:AIReviewPromptConfigurationShape
    a sh:NodeShape ;
    sh:targetClass secav:AIReviewPromptConfiguration ;
    sh:property [
        sh:path secav:hasContextDefinition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a context definition (step 1)."@en
    ] ;
    sh:property [
        sh:path secav:hasImpactAnalysisInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include an impact analysis instruction (step 2)."@en
    ] ;
    sh:property [
        sh:path secav:hasSecurityEvaluationInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a security evaluation instruction (step 3)."@en
    ] ;
    sh:property [
        sh:path secav:hasTestGenerationInstruction ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An AI review prompt configuration must include a test generation instruction (step 4)."@en
    ] .

secav:AdoptionBehaviorShape
    a sh:NodeShape ;
    sh:targetClass secav:AdoptionBehavior ;
    sh:property [
        sh:path secav:belongsToPillar ;
        sh:minCount 1 ;
        sh:class secav:AdoptionPillar ;
        sh:message "An adoption behavior must belong to at least one adoption pillar."@en
    ] .

secav:CoachObservationShape
    a sh:NodeShape ;
    sh:targetClass secav:CoachObservation ;
    sh:property [
        sh:path secav:observedDuring ;
        sh:minCount 1 ;
        sh:class secav:EngineeringActivity ;
        sh:message "A coach observation must be linked to the engineering activity during which it was recorded."@en
    ] ;
    sh:property [
        sh:path secav:observationStatement ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A coach observation must include a verbatim statement of what was observed."@en
    ] .
