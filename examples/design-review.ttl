@prefix secav: <https://github.com/vlorenzana/software-engineering-coaching-framework/ontology/secav-o#> .
@prefix ex: <https://example.org/secav/demo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# Valid scenario — design review with direct coach sign-off
# Satisfies: ReviewActivityShape, ReviewCertifiedShape, CoachReviewSignOffShape
# ---------------------------------------------------------------------------

ex:EngineerA
    a secav:Engineer ;
    secav:performs ex:DesignImplementation01 .

ex:DesignImplementation01
    a secav:DesignImplementation, secav:AIAssistedActivity ;
    secav:requiresCompetency ex:DesignCompetency01 ;
    secav:produces ex:DesignArtifact01 ;
    secav:assistedByAI ex:AIAssistant01 ;
    secav:requiresHumanValidation ex:DesignReview01 ;
    secav:assessedAgainst ex:CriterionModifiability .

ex:AIAssistant01 a secav:AISystem .
ex:DesignCompetency01 a secav:DesignCompetency .
ex:ReviewCompetency01 a secav:ReviewCompetency .
ex:DesignArtifact01 a secav:DesignArtifact .

ex:CriterionModifiability
    a secav:AcceptanceCriterion ;
    secav:criterionStatement "The design identifies responsibilities, dependencies, and an explicit rationale for decisions that materially affect modifiability." .

ex:DesignReview01
    a secav:DesignReview, secav:HumanValidationActivity ;
    secav:requiresCompetency ex:ReviewCompetency01 ;
    secav:evaluates ex:DesignArtifact01 ;
    secav:produces ex:ReviewRecord01 ;
    secav:producesReviewFinding ex:Finding01 ;
    secav:hasSignOff ex:SignOff01 .

ex:Finding01
    a secav:ReviewFinding ;
    secav:findingDescription "One undocumented dependency detected; explicit design rationale requested before implementation." .

ex:SignOff01
    a secav:CoachReviewSignOff ;
    secav:signOffStatement "Review conducted acceptably: participants prepared, roles observed, finding documented." ;
    secav:signOffDate "2026-10-22"^^xsd:date .

ex:ReviewRecord01
    a secav:ReviewRecord ;
    secav:evidenceNote "Reviewer identified one undocumented dependency and requested an explicit design rationale." ;
    secav:providesEvidenceOf ex:ReviewCompetency01 ;
    secav:triggers ex:CoachingIntervention01 .

ex:Assessment01
    a secav:CompetencyAssessment ;
    secav:assessesCompetency ex:ReviewCompetency01 ;
    secav:basedOnEvidence ex:ReviewRecord01 ;
    secav:assessmentRationale "Assessment is based on the review record only and should be combined with repeated observations before drawing broader conclusions." .

ex:CoachingIntervention01
    a secav:CoachingIntervention ;
    secav:targetsCompetency ex:ReviewCompetency01 .

# ---------------------------------------------------------------------------
# Remote-endorsement scenario — coach absent, designated observer attended
# Satisfies: ReviewCertifiedShape (remote path), CoachRemoteEndorsementShape,
#            ObserverReportShape, traceability SPARQL constraint
# ---------------------------------------------------------------------------

ex:DesignReview02
    a secav:DesignReview, secav:HumanValidationActivity ;
    secav:requiresCompetency ex:ReviewCompetency01 ;
    secav:evaluates ex:DesignArtifact01 ;
    secav:producesReviewFinding ex:Finding02 ;
    secav:hasRemoteEndorsement ex:RemoteEndorsement01 .

ex:Finding02
    a secav:ReviewFinding ;
    secav:findingDescription "No defects found. Modifiability criterion satisfied. Rationale documented in design artifact." .

ex:AbsenceRecord01
    a secav:CoachAbsenceRecord ;
    secav:absenceReason "Coach attending parallel formal inspection of critical payment module." ;
    secav:absenceConsequence "No CoachReviewSignOff can be issued for this session; findings provisional until remote endorsement." ;
    secav:designatedObserver ex:TechLead01 ;
    secav:hasObserverReport ex:ObserverReport01 .

ex:TechLead01 a secav:Stakeholder .

ex:ObserverReport01
    a secav:ObserverReport ;
    secav:reportedBy ex:TechLead01 ;
    secav:observerReportDate "2026-10-22"^^xsd:date ;
    secav:reportedFindings "Session conducted in accordance with design walkthrough protocol. All participants prepared. One finding raised (no defects beyond the finding documented in Finding02). No entry criterion violations." .

ex:RemoteEndorsement01
    a secav:CoachRemoteEndorsement ;
    secav:remoteEndorsementReason "Coach was at parallel critical inspection; TechLead01 designated as observer in advance." ;
    secav:remoteEndorsementDate "2026-10-22"^^xsd:date ;
    secav:endorsedObserverReport ex:ObserverReport01 ;
    secav:correspondingAbsenceRecord ex:AbsenceRecord01 .